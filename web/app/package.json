{
  "name": "@troubadour/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm -C ../packages/api gen",
    "build": "tsc --noEmit && vite build",
    "pretypecheck": "pnpm -C ../packages/api gen",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC vitest run --project app --project browser --passWithNoTests",
    "shot": "node scripts/shot.ts",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.0",
    "@troubadour/api": "workspace:*",
    "@troubadour/ui": "workspace:*",
    "@yipe/tokens": "workspace:*",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.9.0",
    "react-virtuoso": "^4.18.16",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.56.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
